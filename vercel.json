{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python3 scripts/stage_static.py",
  "rewrites": [
    {"source": "/(.*)", "destination": "/api/index"}
  ],
  "functions": {
    "api/index.py": {
      "includeFiles": "{platform_app/**,sample_data/**}",
      "maxDuration": 30
    }
  }
}
